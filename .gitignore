# Share only the standard app, its build inputs and required notices.
# Everything else stays local unless explicitly added here.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/MCCTheaterCapture.sln
!/NuGet.Config
!/build.ps1
!/package.ps1
!/Launch.ps1
!/Record-Film.ps1

!/native/
/native/*
!/native/*.cpp
!/native/*.h
!/native/app.manifest
!/native/build.ps1
!/native/THIRD_PARTY_LICENSES.txt

!/shell/
/shell/*
!/shell/*.cs
!/shell/MCCTheaterCapture.csproj
!/shell/app.manifest
!/shell/build.ps1
!/shell/web/
/shell/web/*
!/shell/web/home.html
!/shell/web/home.css
!/shell/web/home.js
!/shell/web/map-names.js

!/docs/
/docs/*
!/docs/BUILD.md

!/tools/
/tools/*
!/tools/Test-ProjectIsolation.ps1
!/tools/Test-MinimalFFmpeg.ps1
!/tools/Build-MinimalFFmpeg.ps1
!/tools/Build-MinimalFFmpeg.sh
!/tools/Export-FFmpegSource.ps1

# Small runtime libraries and exact FFmpeg sources used by packaging.
# Supply the full WebView2 browser runtime separately when packaging.
!/deps/
/deps/**
!/deps/**/
!/deps/vendor-identities.json
!/deps/FreeType/freetype.dll
!/deps/FreeType/FreeType-FTL.txt
!/deps/WebView2/LICENSE.txt
!/deps/WebView2/NOTICE.txt
!/deps/WebView2/lib/net462/Microsoft.Web.WebView2.Core.dll
!/deps/WebView2/lib/net462/Microsoft.Web.WebView2.Wpf.dll
!/deps/WebView2/runtimes/win-x64/native/WebView2Loader.dll
!/deps/WebView2Fixed/manifest.json
/deps/WebView2Fixed/*/
!/deps/FFmpeg/bin/ffmpeg.exe
!/deps/FFmpeg/bin/ffprobe.exe
!/deps/FFmpeg/LICENSE
!/deps/FFmpeg/README.txt
!/deps/FFmpeg/SOURCE-BUILD.txt
!/deps/FFmpeg/zlib-LICENSE.txt
!/deps/FFmpeg/x264-LICENSE.txt
!/deps/FFmpeg/build-manifest.json
!/deps/FFmpeg/manifest.json
!/deps/FFmpeg/ffmpeg-config.h
!/deps/FFmpeg/ffmpeg-config_components.h
!/deps/FFmpeg/ffmpeg-config.asm
!/deps/FFmpeg/x264-config.h
!/deps/FFmpeg/source/ffmpeg-9.0.2.tar.xz
!/deps/FFmpeg/source/x264-stable.tar.gz
!/deps/FFmpeg/source/zlib-1.3.2.tar.gz

# Keep machine state local even beneath allowed source directories.
**/obj/
**/UserData/
**/BetaUserData/
**/Captures/
**/node_modules/
**/.env
**/.env.*
**/credentials.json
*.user
*.suo
*.pdb
*.obj
*.ilk
*.log
*.tmp
